@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coming Soon || NSIA Prize for Innovation</title>
    <link rel="icon" type="image/png" sizes="16x16"
          href="https://web.archive.org/web/20250328161536im_/http://nsia-ip.com/assets/images/favicons/favicon-16x16.png" />
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100;200;300;400;500;600;700;800;900&display=swap');

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --teal: #2DB8B0;
                --teal-d: #1a9990;
                --teal-deep: #0d7a73;
                --teal-light: #E8F7F6;
                --teal-pale: #F0FAF9;
                --green: #7BC144;
                --green-dark: #5a9130;
                --ink: #1C2B2A;
                --cream: #F5F9F8;
                --off: #EEF4F3;
                --muted: #4A6260;
                --border: rgba(45, 184, 176, 0.2);
                --nav-h: 62px;
                --step-h: 56px;
            }

            .cs-wrap {
                min-height: 100vh;
                background: var(--cream);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 3rem 1.5rem;
                font-family: 'DM Sans', sans-serif;
                position: relative;
                overflow: hidden;
            }

            .cs-wrap::before {
                content: '';
                position: absolute;
                inset: 0;
                @* background:
                    radial-gradient(ellipse at 20% 30%, rgba(45, 184, 176, 0.12) 0%, transparent 55%),
                    radial-gradient(ellipse at 80% 70%, rgba(123, 193, 68, 0.08) 0%, transparent 50%); *@
                pointer-events: none;
            }

            .cs-logo {
                margin-bottom: 2.5rem;
                position: relative;
                z-index: 1;
            }

            .cs-logo img {
                height: 70px;
                width: auto;
                margin-bottom: 3rem;
                @* filter: brightness(0) invert(1); *@
            }

            .cs-logo-text {
                font-family: 'DM Sans', sans-serif;
                font-size: 13px;
                font-weight: 500;
                color: var(--ink);
                letter-spacing: .18em;
                text-transform: uppercase;
                text-align: center;
                margin-top: 8px;
            }

            .cs-eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: rgba(45, 184, 176, 0.12);
                border: 1px solid rgba(45, 184, 176, 0.25);
                padding: .3rem .85rem;
                border-radius: 100px;
                font-size: 11px;
                font-weight: 500;
                color: #2DB8B0;
                letter-spacing: .1em;
                text-transform: uppercase;
                margin-bottom: 1.75rem;
                position: relative;
                z-index: 1;
            }

            .cs-eyebrow-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #2DB8B0;
                animation: pulse 2s ease-in-out infinite;
            }

            @@keyframes pulse {

                0%,
                100% {
                    opacity: 1
                }

                50% {
                    opacity: .3
                }
            }

            .cs-title {
                font-family: 'Cormorant Garamond', serif;
                font-size: clamp(2.2rem, 6vw, 3.5rem);
                font-weight: 700;
                color: #1C2B2A;
                text-align: center;
                line-height: 1.1;
                margin-bottom: .75rem;
                position: relative;
                z-index: 1;
            }

            .cs-title em {
                color: #7BC144;
                font-style: italic;
            }

            .cs-sub {
                font-size: .92rem;
                color: #1C2B2A;
                text-align: center;
                line-height: 1.75;
                max-width: 420px;
                margin-bottom: 3rem;
                font-weight: 300;
                position: relative;
                z-index: 1;
            }

            .cs-countdown {
                display: flex;
                align-items: flex-start;
                gap: 1rem;
                margin-bottom: 3rem;
                position: relative;
                z-index: 1;
                flex-wrap: wrap;
                justify-content: center;
            }

            .cs-unit {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: .5rem;
            }

            .cs-digits {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(45, 184, 176, 0.2);
                border-radius: 12px;
                padding: 1.25rem 1.5rem;
                min-width: 90px;
                text-align: center;
                position: relative;
                overflow: hidden;
            }

            .cs-digits::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 0;
                right: 0;
                height: 1px;
                background: rgba(45, 184, 176, 0.1);
            }

            .cs-num {
                font-family: 'Cormorant Garamond', serif;
                font-size: 3rem;
                font-weight: 700;
                color: #1C2B2A;
                line-height: 1;
                letter-spacing: .02em;
                display: block;
                transition: opacity .15s;
            }

            .cs-label {
                font-size: 10px;
                color: #1C2B2A;
                text-transform: uppercase;
                letter-spacing: .12em;
                font-weight: 500;
            }

            .cs-sep {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2.5rem;
                font-weight: 600;
                color: #1C2B2A;
                padding-top: .9rem;
                user-select: none;
            }

            .cs-deadline {
                display: flex;
                align-items: center;
                gap: .5rem;
                font-size: .78rem;
                color: #1C2B2A;
                @* margin-bottom: 3rem; *@
                position: relative;
                z-index: 1;
            }

            .cs-deadline svg {
                width: 14px;
                height: 14px;
                stroke: #1C2B2A;
                stroke-width: 1.75;
                font-weight: 700;
                fill: none;
            }

            .cs-deadline strong {
                color: #1C2B2A;
                font-weight: 700;
            }

            .cs-bar {
                width: min(480px, 90%);
                height: 3px;
                background: rgba(255, 255, 255, 0.06);
                border-radius: 100px;
                overflow: hidden;
                @* margin-bottom: 3rem; *@
                position: relative;
                z-index: 1;
            }

            .cs-bar-fill {
                height: 100%;
                background: linear-gradient(to right, #2DB8B0, #7BC144);
                border-radius: 100px;
                transition: width 1s linear;
            }

            .cs-done {
                display: none;
                flex-direction: column;
                align-items: center;
                gap: 1rem;
                position: relative;
                z-index: 1;
            }

            .cs-done-icon {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                background: rgba(45, 184, 176, 0.15);
                border: 1px solid rgba(45, 184, 176, 0.3);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: .5rem;
            }

            .cs-done-icon svg {
                width: 32px;
                height: 32px;
                stroke: #2DB8B0;
                stroke-width: 2;
                fill: none;
            }

            .cs-done-title {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2rem;
                font-weight: 700;
                color: #1C2B2A;
                text-align: center;
            }

            .cs-done-sub {
                font-size: .85rem;
                color: #1C2B2A;
                text-align: center;
            }

            .cs-footer {
                position: relative;
                z-index: 1;
                font-size: .72rem;
                color: #1C2B2A;
                text-align: center;
                letter-spacing: .05em;
            }

            @@media (max-width: 480px) {
                .cs-digits {
                    min-width: 68px;
                    padding: .9rem 1rem;
                }

                .cs-num {
                    font-size: 2.2rem;
                }

                .cs-sep {
                    font-size: 1.8rem;
                    padding-top: .7rem;
                }

                .cs-countdown {
                    gap: .5rem;
                }
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .brand-icon img {
                width: 150px;
                height: 38px;
            }
    </style>
</head>

<body>
    <div class="cs-wrap">

        <div class="cs-logo">
            <a href=""><img src="~/assets/images/logo.png" alt="NSIA" /></a>
            <div class="cs-logo-text">NSIA Prize for Innovation 4.0</div>
        </div>

        @* <div class="cs-eyebrow">
            <span class="cs-eyebrow-dot"></span>
            Applications Opening Soon
        </div> *@

        <h1 class="cs-title">
            Get Ready To Submit<br /> Your <em>Innovation!</em>
        </h1><br />

        <div class="cs-countdown" id="countdown">
            <div class="cs-unit">
                <div class="cs-digits"><span class="cs-num" id="cd-h">00</span></div>
                <span class="cs-label">Hours</span>
            </div>
            <div class="cs-sep">:</div>
            <div class="cs-unit">
                <div class="cs-digits"><span class="cs-num" id="cd-m">00</span></div>
                <span class="cs-label">Minutes</span>
            </div>
            <div class="cs-sep">:</div>
            <div class="cs-unit">
                <div class="cs-digits"><span class="cs-num" id="cd-s">00</span></div>
                <span class="cs-label">Seconds</span>
            </div>
        </div>

        <div class="cs-bar">
            <div class="cs-bar-fill" id="cs-progress" style="width:0%"></div>
        </div>

        <div class="cs-deadline">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            <strong>Portal Opens:</strong>Sunday, 8 June 2026 · 12:00 AM WAT
        </div>

        <div class="cs-done" id="cs-done">
            <div class="cs-done-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <div class="cs-done-title">We're live!</div>
            <div class="cs-done-sub">The NPI 4.0 portal is now open. Good luck!</div>
        </div>

        @* <div class="cs-footer">NSIA Prize for Innovation 4.0 &nbsp;·&nbsp; nsia-ip.com</div> *@

    </div>

    <script>
            // Target: 8 June 2026 00:00:00 WAT (UTC+1)
            const target = new Date('2026-06-07T23:00:00Z'); // midnight WAT = 23:00 UTC previous day

            // Total duration from now to target (for progress bar)
            const now0 = Date.now();
            const totalMs = Math.max(target.getTime() - now0, 1);

            function pad(n) { return String(n).padStart(2, '0'); }

            function tick() {
                const now = Date.now();
                const diff = target.getTime() - now;

                if (diff <= 0) {
                    document.getElementById('countdown').style.display = 'none';
                    document.getElementById('cs-progress').style.width = '100%';
                    document.getElementById('cs-done').style.display = 'flex';
                    return;
                }

                const totalSec = Math.floor(diff / 1000);
                const h = Math.floor(totalSec / 3600);
                const m = Math.floor((totalSec % 3600) / 60);
                const s = totalSec % 60;

                document.getElementById('cd-h').textContent = pad(h);
                document.getElementById('cd-m').textContent = pad(m);
                document.getElementById('cd-s').textContent = pad(s);

                const elapsed = now - now0;
                const pct = Math.min(100, Math.round(elapsed / totalMs * 100));
                document.getElementById('cs-progress').style.width = pct + '%';
            }

            tick();
            setInterval(tick, 1000);
    </script>
</body>

</html>




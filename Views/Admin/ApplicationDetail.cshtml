                        <div class="field-value">@Val(app.SustainabilityIntegration)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Energy &amp; Waste Reduction</div>
                        <div class="field-value">@Val(app.EnergyWasteReduction)</div>
                    </div>
                </div>
            </div>

            <div class="s-card">
                <div class="s-card-header">
                    <div class="s-card-header-icon"><svg viewBox="0 0 24 24">
                        <path d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12" />
                        <path d="M12 6v6l4 2" />
                    </svg></div>
                    <span class="s-card-header-title">Climate &amp; Digital Access</span>
                </div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div class="field-label">Sustainability Technology</div>
                        <div class="field-value">@Val(app.SustainabilityTechnology)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Scaling with Sustainability</div>
                        <div class="field-value">@Val(app.ScalingWithSustainability)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Climate Change Approach</div>
                        <div class="field-value">@Val(app.ClimateChangeApproach)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Digital Accessibility</div>
                        <div class="field-value">@Val(app.DigitalAccessibility)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════
     STEP 9 — Impact
══════════════════════════════════════ -->
        <div class="section-divider">Step 9 — Impact</div>
        <div class="cards-grid">
            <div class="s-card">
                <div class="s-card-header">
                    <div class="s-card-header-icon"><svg viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg></div>
                    <span class="s-card-header-title">Market Reach &amp; Equity</span>
                </div>
                <div class="s-card-body">
                    <div class="fields-grid-2">
                        <div class="field-row">
                            <div class="field-label">Underserved Market %</div>
                            <div class="field-value">@Val(app.UnderservedMarketPercentage)</div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Population Impacted</div>
                            <div class="field-value">@Val(app.PopulationImpacted)</div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Jobs Created</div>
                            <div class="field-value">@Val(app.JobsCreated)</div>
                        </div>
                        <div class="field-row">
                            <div class="field-label">Gender Gap Approach</div>
                            <div class="field-value">@Val(app.GenderGapApproach)</div>
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Systemic Inequality Approach</div>
                        <div class="field-value">@Val(app.SystemicInequalityApproach)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Beneficiary Involvement</div>
                        <div class="field-value">@Val(app.BeneficiaryInvolvement)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Access for Underserved</div>
                        <div class="field-value">@Val(app.AccessForUnderserved)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Resource Optimization</div>
                        <div class="field-value">@Val(app.ResourceOptimization)</div>
                    </div>
                </div>
            </div>

            <div class="s-card">
                <div class="s-card-header">
                    <div class="s-card-header-icon"><svg viewBox="0 0 24 24">
                        <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg></div>
                    <span class="s-card-header-title">Social Contribution &amp; Ethics</span>
                </div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div class="field-label">Impact Data Sharing</div>
                        <div class="field-value">@Val(app.ImpactDataSharing)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Data Protection</div>
                        <div class="field-value">@Val(app.DataProtection)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Social Good Contribution</div>
                        <div class="field-value">@Val(app.SocialGoodContribution)</div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Ethical Operations</div>
                        <div class="field-value tags">
                            @if (!string.IsNullOrEmpty(app.EthicalOperations))
                            {
                                @foreach (var t in app.EthicalOperations.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="tag">@t.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="empty">—</span>
                            }
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Diversity &amp; Inclusion</div>
                        <div class="field-value tags">
                            @if (!string.IsNullOrEmpty(app.DiversityInclusion))
                            {
                                @foreach (var t in app.DiversityInclusion.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="tag">@t.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="empty">—</span>
                            }
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Equitable Opportunities</div>
                        <div class="field-value tags">
                            @if (!string.IsNullOrEmpty(app.EquitableOpportunities))
                            {
                                @foreach (var t in app.EquitableOpportunities.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="tag">@t.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="empty">—</span>
                            }
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field-label">Accessibility for Disadvantaged</div>
                        <div class="field-value tags">
                            @if (!string.IsNullOrEmpty(app.AccessibilityForDisadvantaged))
                            {
                                @foreach (var t in app.AccessibilityForDisadvantaged.Split(',',
                            StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="tag">@t.Trim()</span>
                                }
                            }
                            else
                            {
                                <span class="empty">—</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════
     STEP 10 — Additional & Documents
══════════════════════════════════════ -->
        <div class="section-divider">Step 10 — Additional Information &amp; Documents</div>
        <div class="cards-grid">
            <div class="s-card">
                <div class="s-card-header">
                    <div class="s-card-header-icon"><svg viewBox="0 0 24 24">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg></div>
                    <span class="s-card-header-title">Additional Notes</span>
                </div>
                <div class="s-card-body">
                    <div class="field-row">
                        <div class="field-label">Notes from applicant</div>
                        @if (!string.IsNullOrWhiteSpace(app.AdditionalInformation))
                        {
                            <div class="notes-block">@app.AdditionalInformation</div>
                        }
                        else
                        {
                            <div class="field-value empty">None provided</div>
                        }
                    </div>

                    <!-- Agreements -->
                    <div class="field-row" style="margin-top:.25rem;">
                        <div class="field-label" style="margin-bottom:.5rem">Declarations</div>
                        <div style="display:flex;flex-direction:column;gap:.5rem">
                            <div class="agree-row">
                                <div class="agree-check @(app.AgreesToTermsOfService ? "yes" : "no")">
                                    @if (app.AgreesToTermsOfService)
                                    {
                                        <svg viewBox="0 0 12 12">
                                            <polyline points="2,6 5,9 10,3" />
                                        </svg>
                                    }
                                </div>
                                Agreed to Terms of Service
                            </div>
                            <div class="agree-row">
                                <div class="agree-check @(app.AgreesToPrivacyPolicy ? "yes" : "no")">
                                    @if (app.AgreesToPrivacyPolicy)
                                    {
                                        <svg viewBox="0 0 12 12">
                                            <polyline points="2,6 5,9 10,3" />
                                        </svg>
                                    }
                                </div>
                                Agreed to Privacy Policy
                            </div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label">Submitted At</div>
                        <div class="field-value">
                            @(app.SubmittedAt.HasValue
                                ? app.SubmittedAt.Value.ToString("d MMMM yyyy, HH:mm")
                                : "Not yet submitted")
                        </div>
                    </div>
                </div>
            </div>

            <div class="s-card">
                <div class="s-card-header">
                    <div class="s-card-header-icon"><svg viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="17 8 12 3 7 8" />
                        <line x1="12" y1="3" x2="12" y2="15" />
                    </svg></div>
                    <span class="s-card-header-title">Supporting Documents</span>
                    <span class="s-card-header-badge">@docs.Count file@(docs.Count == 1 ? "" : "s")</span>
                </div>
                <div class="s-card-body">
                    @if (!docs.Any())
                    {
                        <div class="field-value empty">No documents uploaded.</div>
                    }
                    else
                    {
                        <div class="doc-list">
                            @foreach (var doc in docs.OrderBy(d => d.UploadedAt))
                            {
                                var ext = doc.FileExtension?.TrimStart('.').ToUpperInvariant() ?? "FILE";
                                <div class="doc-item">
                                    <div class="doc-ext">@ext</div>
                                    <div style="flex:1;min-width:0">
                                        <div class="doc-name">@doc.OriginalFileName</div>
                                        <div class="doc-meta">@doc.DocumentType &nbsp;·&nbsp; @FormatSize(doc.FileSizeBytes)
                                            &nbsp;·&nbsp; @doc.UploadedAt.ToString("d MMM yyyy")</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(doc.StoredFilePath))
                                        {
                                            <a href="/uploads/@doc.StoredFilePath" target="_blank" class="doc-download">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                    <polyline points="7 10 12 15 17 10" />
                                                    <line x1="12" y1="15" x2="12" y2="3" />
                                                </svg>
                                                Download
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

        }
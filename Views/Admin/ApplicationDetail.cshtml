                            ("Instagram", app.SocialMedia?.Instagram),
                            ("LinkedIn", app.SocialMedia?.LinkedIn),
                            ("Facebook", app.SocialMedia?.Facebook),
                        };
                                var hasSocials = socials.Any(s => !string.IsNullOrWhiteSpace(s.Value));
                            }
                            @if (hasSocials)
                            {
                                <div style="display:flex;flex-direction:column;gap:.25rem;">
                                    @foreach (var (label, value) in socials.Where(s => !string.IsNullOrWhiteSpace(s.Value)))
                                    {
                                        <span style="font-size:.76rem"><span style="color:var(--muted)">@label:</span> @value</span>
                                    }
                                </div>
